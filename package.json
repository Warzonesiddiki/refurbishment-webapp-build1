{
  "name": "tahir-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev_with_java.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --strictPort",
    "launcher": "python tools/local_launcher_gui.py || python3 tools/local_launcher_gui.py",
    "java:server": "bash tools/run_java_server.sh 8085",
    "test": "vitest",
    "test:watch": "vitest",
    "test:legacy-config": "vitest run --config tests/vitest.config.ts",
    "lint": "npm run typecheck",
    "lint:fix": "npm run typecheck",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\" \"e2e/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\" \"e2e/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report e2e/report",
    "test:e2e:update-baseline": "playwright test --update-snapshots",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:all": "npm run test:run && npm run test:e2e",
    "prepare": "husky",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "start:local": "npm run build && npm run preview",
    "serve:java": "java -jar server/tahir-erp-server.jar",
    "dev:lan": "node tools/dev_with_java.mjs --lan",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "serve:lan": "npm run dev:lan",
    "build:pwa": "npm run build && npm run preview:lan",
    "check:mobile": "npm run typecheck && npx vitest run tests/pwaUtils.test.ts tests/networkUtils.test.ts",
    "check:ops": "npx vitest run tests/wipPartReplacement.test.ts tests/integration/wipFlow.test.ts",
    "check:offline-queue": "vitest run tests/offlineQueueUtils.test.ts tests/useOfflineQueue.test.ts tests/offlineQueueBanner.test.tsx",
    "check:labor-flow": "vitest run tests/wipLaborApproval.test.ts tests/wipQualityGate.test.ts tests/laborTimerUtils.test.ts tests/useLaborTimer.test.ts",
    "check:replay-analytics": "vitest run tests/browserStorage.test.ts tests/offlineReplayAuditUtils.test.ts tests/offlineReplayAuditPanel.test.tsx tests/wipQualityAnalytics.test.ts tests/wipLaborEfficiency.test.ts tests/wipProductivity.test.ts tests/wipLaborDrilldown.test.ts tests/offlineConflictPolicy.test.ts tests/wipTrackTrend.test.ts tests/offlineEscalation.test.ts tests/useOfflineEscalation.test.ts",
    "check:release-readiness": "bash tools/release_readiness.sh",
    "check:prerequisites": "python tools/preflight_check.py || python3 tools/preflight_check.py",
    "check:core-areas": "vitest run tests/integration/inventoryFlow.test.ts tests/integration/wipFlow.test.ts tests/batch4/partReducer.test.ts tests/wipStageTransition.test.ts tests/wipPartReplacement.test.ts tests/wipQualityGate.test.ts",
    "dev:with-java": "node tools/dev_with_java.mjs",
    "dev:lan:with-java": "node tools/dev_with_java.mjs --lan",
    "deps:install": "npm install --legacy-peer-deps --no-audit --no-fund",
    "deps:ci": "npm ci --legacy-peer-deps --no-audit --no-fund",
    "dev:web": "vite --host 0.0.0.0 --strictPort",
    "dev:lan:web": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "check:sla-wip": "vitest run tests/wipAging.test.ts tests/wipStageTransition.test.ts tests/wipPartReplacement.test.ts tests/wipQualityGate.test.ts tests/integration/wipFlow.test.ts",
    "java:server:mvn": "mvn -q -f java_server/pom.xml -DskipTests compile exec:java -Dexec.args=8085",
    "java:server:javac": "python tools/run_java_server.py 8085 --build-tool=javac || python3 tools/run_java_server.py 8085 --build-tool=javac",
    "dev:no-java": "node tools/dev_with_java.mjs --no-java",
    "dev:lan:no-java": "node tools/dev_with_java.mjs --lan --no-java"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vite-plugin-singlefile": "2.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^28.0.0",
    "vitest": "^4.0.18",
    "@playwright/test": "^1.44.0",
    "@axe-core/playwright": "^4.9.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.0",
    "standard-version": "^9.5.0",
    "eslint": "^9.20.0",
    "@eslint/js": "^9.20.0",
    "typescript-eslint": "^8.24.0",
    "prettier": "^3.5.0",
    "@vitest/coverage-v8": "^4.0.18"
  }
}
