{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "launcher": "python3 tools/local_launcher_gui.py",
    "java:server": "bash tools/run_java_server.sh 8085",
    "test": "vitest",
    "test:watch": "vitest",
    "test:legacy-config": "vitest run --config tests/vitest.config.ts",
    "lint": "eslint src e2e --ext ts,tsx --max-warnings 0",
    "lint:fix": "eslint src e2e --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\" \"e2e/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\" \"e2e/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report e2e/report",
    "test:e2e:update-baseline": "playwright test --update-snapshots",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:all": "npm run test:run && npm run test:e2e",
    "prepare": "husky install",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "start:local": "npm run build && npm run preview",
    "serve:java": "java -jar server/almasfufa-server.jar"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vite-plugin-singlefile": "2.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^28.0.0",
    "vitest": "^4.0.18",
    "@playwright/test": "^1.44.0",
    "@axe-core/playwright": "^4.9.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.0",
    "standard-version": "^9.5.0",
    "eslint": "^9.20.0",
    "@eslint/js": "^9.20.0",
    "typescript-eslint": "^8.24.0",
    "prettier": "^3.5.0"
  }
}