# Core app / API configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=almasfufa
DB_USER=postgres
DB_PASS=postgres

JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRY=15m

API_PORT=8085
FRONTEND_PORT=4173

# Domain defaults
LABOR_RATE_PER_HOUR=50
DEFAULT_WARRANTY_MONTHS=3

# Optional frontend API wiring
VITE_API_BASE_URL=http://localhost:8085/api/v1
VITE_JAVA_API_BASE=/api
VITE_LOCAL_API_PROXY_TARGET=http://localhost:8085

# Docker/LAN networking overrides
WEB_BIND_HOST=0.0.0.0
WEB_PORT=4173
JAVA_BIND_HOST=0.0.0.0
JAVA_API_PORT=8085
ADMINER_BIND_HOST=0.0.0.0
ADMINER_PORT=8080
DB_BIND_HOST=127.0.0.1

# Java API CORS/network policy
TAHIR_ALLOWED_ORIGIN=*
TAHIR_TRUST_PRIVATE_NETWORK_ORIGINS=true
