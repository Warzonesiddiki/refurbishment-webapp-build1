{
  "name": "Tahir ERP",
  "short_name": "TahirERP",
  "description": "Enterprise laptop refurbishment operations and WIP tracking",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#06060e",
  "theme_color": "#0b1221",
  "orientation": "portrait",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/apple-touch-icon.svg",
      "sizes": "180x180",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    { "name": "Scanner", "url": "/?page=scanner", "description": "Open scanner workflow" },
    { "name": "WIP Jobs", "url": "/?page=processing-wip", "description": "Open WIP jobs" },
    { "name": "Inventory Parts", "url": "/?page=inventory-parts", "description": "Open parts inventory" }
  ]
}
